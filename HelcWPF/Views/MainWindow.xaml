<Window x:Class="HelcWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
         xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
        mc:Ignorable="d"
        Title="HALCON视觉检测"
        Height="850" Width="1280"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="Button" x:Key="windowOperateBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF1E90FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF104E8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="UserOperateBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Width" Value="95"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>     <!-- 0 标题栏 -->
            <RowDefinition Height="60"/>     <!-- 1 工具条 -->
            <RowDefinition Height="*"/>      <!-- 2 内容区（步骤 2 放图像） -->
            <RowDefinition Height="40"/>     <!-- 3 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Background="#1171D1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="HALCON视觉检测" Foreground="White" FontWeight="Bold" FontSize="18"
                       VerticalAlignment="Center" Margin="10,0"/>
            <!-- IsHitTestVisibleInChrome：自绘标题栏上的按钮要加这个，鼠标事件才收得到 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="-" Width="40" FontSize="20" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Minimize_Click"/>
                <Button Content="□" Width="40" FontSize="16" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Maximize_Click"/>
                <Button Content="×" Width="40" FontSize="18" Margin="5,0"
                        Style="{StaticResource windowOperateBtn}" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- 按钮Row 1 -->
        <Border Grid.Row="1" Background="#FFE5EFFA">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- ★ 改：补上 Command（原来没有，点了没反应） -->
                    <Button Style="{StaticResource UserOperateBtn}" Content="选择文件夹" Margin="5,0"
                            Command="{Binding SelectFolderCommand}"/>

                   
                    <ToggleButton IsChecked="{Binding IsAutoMode, Mode=TwoWay}" Content="手动切换" Margin="5,0" VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <StackPanel Orientation="Vertical">
                                    <Grid>
                                        <Border CornerRadius="14" Height="30" Width="55" BorderThickness="0" Background="#3B82F6" BorderBrush="#3B82F6" Margin="5,5,5,0">
                                            <Border x:Name="P" Height="27" Width="27" Background="#FFFCBE47" CornerRadius="20" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="text" Margin="0,2,0,0" FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="P" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="P" Property="Margin" Value="0,0,2,0"/>
                                        <Setter TargetName="text" Property="Text" Value="自动切换"/>
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter TargetName="P" Property="HorizontalAlignment" Value="Left"/>
                                        <Setter TargetName="P" Property="Margin" Value="2,0,0,0"/>
                                        <Setter TargetName="text" Property="Text" Value="手动切换"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <TextBlock Text="切换间隔" VerticalAlignment="Center" Margin="5,0"/>
                    
                    <TextBox Width="50" VerticalAlignment="Center" Margin="5,0"
                             VerticalContentAlignment="Center"
                             Text="{Binding AutoIntervalMs, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Margin="5,0"/>

                    
                    <Button Style="{StaticResource UserOperateBtn}" Content="上一页" Margin="5,0"
                            Command="{Binding PreviousCommand}"/>
                    <Button Style="{StaticResource UserOperateBtn}" Content="下一页" Margin="5,0"
                            Command="{Binding NextCommand}"/>
                </StackPanel>

                
                <TextBlock Text="{Binding FolderPath}" Margin="0,0,15,0" VerticalAlignment="Center"
                           HorizontalAlignment="Right" Foreground="Blue" FontSize="15"
                           MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
            </Grid>
        </Border>

        <!--窗口/操作/读取结果 Row2（步骤 2 会放 HALCON 图像控件）-->
        <Grid Grid.Row="2">
            <halcon:HSmartWindowControlWPF x:Name="HalconView" Grid.Row="2"
                                           
                                       HKeepAspectRatio="False"/>
        </Grid>

        <Border Grid.Row="3" Background="#F3F3F3" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding CurrentFileName}" VerticalAlignment="Center"
                           FontSize="15" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="14" Foreground="#444444"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Grid.Column="2" Text="{Binding ProgressText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="15" Foreground="#1171D1"/>
                    <TextBlock Text="{Binding ImageInfoText}" VerticalAlignment="Center"
                           Margin="16,0" FontSize="14" Foreground="#666666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
